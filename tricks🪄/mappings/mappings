-- ✅ COLORCOLUMN TOGGLE
map("n", "<leader>cl", function()
  if vim.wo.colorcolumn == "" then
    vim.wo.colorcolumn = "80"
  else
    vim.wo.colorcolumn = ""
  end
end, { desc = "Toggle 80 char line" })

-- ✅ INSERT COMMENT WITH SPACE
map("n", "<leader>i", function()
  local row, col = unpack(vim.api.nvim_win_get_cursor(0))
  local line = vim.api.nvim_get_current_line()

  local new_line, cursor_offset

  if vim.bo.filetype == "python" or vim.bo.filetype == "sh" then
    new_line = line .. "  #  "
    cursor_offset = #line + 4
  else
    new_line = line .. " /*  */"
    cursor_offset = #line + 4
  end

  vim.api.nvim_set_current_line(new_line)
  vim.api.nvim_win_set_cursor(0, { row, cursor_offset })
  vim.cmd("startinsert")
end, { desc = "Insert /* */ comment" })

-- Delete whatever in between
map("n", "<leader>b", function()
  local line = vim.api.nvim_get_current_line()
  local row, col = unpack(vim.api.nvim_win_get_cursor(0))
  col = col + 1

  if #line == 0 then
    return
  end

  local delimiters = { "(", ")", "[", "]", "{", "}", "<", ">", '"', "'", "`", ",", ";", ":" }

  local function is_delimiter(char)
    for _, delim in ipairs(delimiters) do
      if char == delim then return true end
    end
    return false
  end

  local left_pos = nil
  local right_pos = nil

  for i = col - 1, 1, -1 do
    if is_delimiter(line:sub(i, i)) then
      left_pos = i
      break
    end
  end

  local start_search = col
  if col <= #line and is_delimiter(line:sub(col, col)) then
    start_search = col + 1
    if not left_pos then
      left_pos = col
    end
  end

  for i = start_search, #line do
    if is_delimiter(line:sub(i, i)) then
      right_pos = i
      break
    end
  end

  if not left_pos or not right_pos then
    return
  end

  if right_pos <= left_pos then
    return
  end

  if right_pos - left_pos <= 1 then
    return
  end

  local before = line:sub(1, left_pos)
  local after = line:sub(right_pos)

  vim.api.nvim_set_current_line(before .. after)
  vim.api.nvim_win_set_cursor(0, {row, left_pos})
end, { desc = "Delete between delimiters" })

-- 🪵 Move between splits (NvimTree & code)
vim.keymap.set("n", "<leader><Left>", "<C-w>h", { desc = "Move to NvimTree (Left)", noremap = true, silent = true })
vim.keymap.set("n", "<leader><Right>", "<C-w>l", { desc = "Move to Code/Right split", noremap = true, silent = true })

-- whitespace dot toggle
map("n", "<leader>ws", function()
  if vim.wo.list then
    vim.wo.list = false
  else
    vim.wo.list = true
    vim.opt.listchars = { space = "·", tab = ">-", eol = "$" }
  end
end, { desc = "Toggle whitespace visibility" })

